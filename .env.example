# Server Configuration
PORT=5000
NODE_ENV=production

# -------------------------------------------------------------
# MySQL Database Configuration
# NOTE: Render does NOT have local MySQL. For Render cloud deployment,
# create a free MySQL database on TiDB Cloud (Serverless) or Aiven:
# -------------------------------------------------------------
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=grocery_mart_db
DB_PORT=3306
DB_SSL=true

# Or use a single Database URL if provided by provider:
# DATABASE_URL=mysql://user:pass@host:port/dbname?ssl-mode=REQUIRED

# JWT Authentication Secret
JWT_SECRET=grocery_mart_super_secret_jwt_key_2026_xyz
JWT_EXPIRES_IN=7d

# Frontend & Admin URLs (Allowed CORS Origins)
CLIENT_URL=https://your-store.vercel.app
ADMIN_URL=https://your-admin.vercel.app
