# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=grocery_mart_db
DB_PORT=3306

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here
